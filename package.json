  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/autoprefixer": "^10.2.0",
    "@types/axios": "^0.14.0",
    "@types/cssnano": "^5.1.0",
    "@types/gh-pages": "^3.2.1",
    "@types/mathjs": "^9.4.2",
